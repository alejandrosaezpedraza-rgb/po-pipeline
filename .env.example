# Copy to .env and edit. Every setting is optional; the defaults are shown.
# Real environment variables override this file.

# ---------------------------------------------------------------- extraction (the only AI step)
# auto   = use the Anthropic API if ANTHROPIC_API_KEY is set, otherwise the `claude` CLI (Claude Code) if signed in
# api    = Anthropic API only
# cli    = `claude -p` headless only
# replay = no AI: plays back samples/truth/*.json for the 5 samples. For UI testing only; the UI labels it.
PO_EXTRACTOR=auto

# Claude model used to read the PDF. Default is a fast current model.
PO_MODEL=claude-haiku-5-5

# Leave empty to use the claude CLI's own sign-in. Set it to use the API instead.
ANTHROPIC_API_KEY=

# Full path to the claude CLI if it is not on PATH.
CLAUDE_BIN=

# Seconds before an extraction attempt is abandoned.
EXTRACT_TIMEOUT=240

# ---------------------------------------------------------------- confirmation email
# dry  = save the email to the customer folder as confirmation_email.eml, send nothing (default)
# live = send over SMTP, but ONLY to addresses listed in SEND_ALLOWED. Anything else stays a draft.
SEND_MODE=dry

# Comma-separated. Exact addresses (you@example.com) or whole domains (@example.com).
SEND_ALLOWED=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=orders@corvane.example

# ---------------------------------------------------------------- mailbox watcher (optional, off by default)
# on = poll the IMAP folder for new emails with a PDF attached. Strictly read-only:
# the folder is opened read-only, messages are fetched with BODY.PEEK (never marked read),
# nothing is moved or deleted. Handled Message-IDs are kept in state/handled_messages.json.
MAILBOX_WATCH=off
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
# Use an app password if your provider offers them.
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60
# Only look at messages from the last N days.
IMAP_LOOKBACK_DAYS=3

# ---------------------------------------------------------------- servers and folders
APP_PORT=7820
ERP_URL=http://127.0.0.1:7811
# STATE_DIR=./state
# CUSTOMERS_DIR=./customers
